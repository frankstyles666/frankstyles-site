---
import Layout from '../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import { pieces } from '../data/pieces.js';

// Pre-optimise overlay gallery images at build time so browser JS gets WebP URLs
const browserPieces = await Promise.all(
  pieces.map(async (piece) => {
    const additionalImages = await Promise.all(
      (piece.additionalImages || []).map(async (imgMeta) => {
        const opt = await getImage({ src: imgMeta, format: 'webp', quality: 85, width: 1200 });
        return { src: opt.src };
      })
    );
    let desktopFirstImage = null;
    if (piece.desktopFirstImage) {
      const opt = await getImage({ src: piece.desktopFirstImage, format: 'webp', quality: 85, width: 1200 });
      desktopFirstImage = { src: opt.src };
    }
    return {
      id: piece.id,
      name: piece.name,
      year: piece.year,
      materials: piece.materials,
      dimensions: piece.dimensions,
      description: piece.description,
      additionalImages,
      desktopFirstImage,
    };
  })
);
---

<Layout title="Frank Styles | Handcrafted Furniture Frome">

  <!-- Left rail -->
  <nav class="side-rail" id="side-rail">
    <p class="site-title" id="site-title">FRANK STYLES</p>
    <ul class="side-nav">
      <li>
        <button class="side-nav__item side-nav__item--commissions" id="commissions-nav-btn">Commissions</button>
        <ul class="commissions-dropdown" id="commissions-dropdown">
          {pieces.filter(p => p.category === 'for-client').map(p => (
            <li><button class="commissions-dropdown__item" data-piece-id={p.id}>{p.name}</button></li>
          ))}
        </ul>
      </li>
      <li>
        <button class="side-nav__item side-nav__item--personal-work" id="personal-work-nav-btn">Personal Work</button>
        <ul class="personal-work-dropdown" id="personal-work-dropdown">
          {pieces.filter(p => p.category === 'for-me').map(p => (
            <li><button class="personal-work-dropdown__item" data-piece-id={p.id}>{p.name}</button></li>
          ))}
        </ul>
      </li>
      <li>
        <button class="side-nav__item" id="all-work-nav-btn">All Work</button>
        <ul class="all-work-dropdown" id="all-work-dropdown">
          {pieces.map(p => (
            <li><button class="all-work-dropdown__item" data-piece-id={p.id}>{p.name}</button></li>
          ))}
        </ul>
      </li>
      <li><button class="side-nav__item" id="about-nav-btn">Information</button></li>
    </ul>
    <a href="https://www.instagram.com/frankstyl.es" target="_blank" rel="noopener noreferrer" class="rail-instagram" aria-label="Instagram">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
        <circle cx="12" cy="12" r="4.5"/>
        <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none"/>
      </svg>
    </a>
  </nav>

  <!-- Piece grid -->
  <main class="piece-grid" id="piece-grid">
    {pieces.map((piece, i) => (
      <article
        class="piece-card"
        data-piece-id={piece.id}
        data-category={piece.category}
        data-index={i}
        role="button"
        tabindex="0"
        aria-label={`View ${piece.name}`}
      >
        <div class="piece-card__img-wrap">
          {piece.mainImage && <Image
            src={piece.mainImage}
            alt={piece.name}
            class="piece-card__img"
            format="webp"
            quality={85}
            width={1200}
            loading={i < 2 ? 'eager' : 'lazy'}
            draggable="false"
          />}
        </div>
        <p class="piece-card__title">{piece.name}</p>
      </article>
    ))}
    <div class="section-intro collab-text" id="collab-text">
      <p>Every commission begins with a conversation about the brief, what it needs to do, where it will live, how it will be used. From there, a detailed design is developed and refined until it's resolved, before a tool is picked up. Where a detail needs to change to serve the piece, that will be said, and explained.</p>
      <p>The result works exactly as intended, ages well, and couldn't have been made for anyone else.</p>
      <p>Get in touch to start a conversation, or book a workshop visit.</p>
    </div>
    <div class="section-intro personal-work-text" id="personal-work-text">
      <p>Pieces made without a client brief. Each one an opportunity to follow the material, work through a joint, or resolve an idea that a commission might never allow.</p>
    </div>
  </main>

  <!-- About view (replaces thumbnails in grid area) -->
  <div class="about-view" id="about-view" aria-hidden="true">
    <div class="about-view__inner">
      <div class="about-view__text">
        <p>Frank Styles is a furniture maker based in Frome, Somerset. His work spans bespoke commissions developed closely with clients and personal pieces, using traditional joinery methods and timber sourced close to home.</p>
        <p>Every piece is built to age well and act as a quiet contribution to your life.</p>
        <p>Pieces start as a conversation, an idea or an instinct. Either way, it's built once, built to be lived with, and left to do the rest.</p>
        <p>Workshop visits by appointment.</p>
        <address>
          <a href="https://www.google.com/maps/search/?api=1&query=Braeside+Works%2C+Wesley+Close%2C+Christchurch+Street+West%2C+Frome%2C+BA11+1EA" target="_blank" rel="noopener noreferrer">
            Braeside Works,<br>Wesley Close,<br>Christchurch Street West,<br>Frome,<br>BA11 1EA
          </a>
          <p><a href="mailto:hello@frankstyl.es">hello@frankstyl.es</a></p>
          <p><a href="tel:+447887497425">+44 7887 497 425</a></p>
        </address>
      </div>
      <img src="/frank-workshop.jpg" alt="Frank Styles in the workshop" class="about-view__photo" />
    </div>
  </div>

  <!-- Overlay backdrop (used by info panel) -->
  <div class="main-overlay" id="main-overlay" aria-hidden="true"></div>
  <div class="main-overlay__content" id="overlay-wrapper" aria-hidden="true">
    <div id="overlay-content"></div>
  </div>

  <!-- Info panel (slides in from left) -->
  <aside class="info-panel" id="info-panel" aria-hidden="true">
    <div class="info-panel__inner">

      <!-- Gallery column -->
      <div class="info-panel__gallery" id="info-gallery">
        <div class="info-panel__gallery-scroll" id="info-gallery-scroll"></div>
        <div class="gallery-progress" id="gallery-progress"></div>
      </div>

      <!-- Details column (revealed when is-wide) -->
      <div class="info-panel__details">
        <button class="close-btn" id="info-close" aria-label="Close">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <line x1="1" y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="1.2"/>
            <line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="1.2"/>
          </svg>
        </button>
        <div class="info-panel__scroll" id="info-scroll">
          <header class="info-panel__header">
            <p class="info-panel__name" id="info-name"></p>
            <p class="info-panel__year" id="info-year"></p>
          </header>
          <dl class="info-panel__meta">
            <dt>Materials</dt>
            <dd id="info-materials"></dd>
            <dt>Dimensions</dt>
            <dd id="info-dimensions"></dd>
          </dl>
          <p class="info-panel__description" id="info-description"></p>
        </div>
      </div>

    </div>
  </aside>

  <!-- View / Collapse images toggle -->
  <button class="info-panel__expand" id="info-expand">View more images</button>

  <!-- Custom cursor label -->
  <div class="custom-cursor" id="custom-cursor" aria-hidden="true">
    <div class="custom-cursor__window">
      <span class="custom-cursor__text">CLICK TO DISCOVER</span>
    </div>
  </div>

  <!-- Backdrop: clicking outside info panel closes it -->
  <div class="info-backdrop" id="info-backdrop" aria-hidden="true"></div>

  <!-- Product scrubber -->
  <div class="piece-scrubber" id="piece-scrubber" aria-hidden="true">
    <button class="piece-scrubber__arrow piece-scrubber__arrow--left" id="arrow-left" aria-label="Previous product">
      <svg width="27" height="51" viewBox="0 0 18 34" fill="none" aria-hidden="true">
        <path d="M14 2 L14 32 L2 17 Z" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="piece-scrubber__arrow piece-scrubber__arrow--right" id="arrow-right" aria-label="Next product">
      <svg width="27" height="51" viewBox="0 0 18 34" fill="none" aria-hidden="true">
        <path d="M4 2 L4 32 L16 17 Z" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <!-- Copyright -->
  <p class="site-copyright">&copy; 2026 Frank Styles.</p>

  <!-- Mobile fixed close button -->
  <button class="close-btn close-btn--mobile-fixed" id="info-close-mobile" aria-label="Close" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <line x1="1" y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="1.2"/>
      <line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="1.2"/>
    </svg>
  </button>


</Layout>

<style>
  /* ── Side rail ────────────────────────────────────── */

  .side-rail {
    position: fixed;
    left: 0;
    top: 0;
    width: 260px;
    height: 100vh;
    z-index: 10;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.5rem;
    background: #faf9f7;
    box-sizing: border-box;
  }

  .site-title {
    font-family: 'SimSun', serif;
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: #353269;
    white-space: nowrap;
    user-select: none;
    cursor: default;
    line-height: 1;
  }

  .site-title.is-overlay-active {
    pointer-events: auto;
    cursor: pointer;
  }

  :global(.site-title__char) {
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .side-nav {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .side-nav__item {
    font-family: 'Roboto Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(53, 50, 105, 0.4);
    padding: 0.45rem 0;
    text-align: left;
    transition: color 0.2s ease;
    cursor: pointer;
  }

  .side-nav__item:hover {
    color: #353269;
  }

  .side-nav__item--commissions,
  .side-nav__item--personal-work {
    color: #353269;
  }

  .side-nav__item--commissions:hover,
  .side-nav__item--personal-work:hover {
    color: #e61515;
  }

  .side-nav__item--commissions.is-faded,
  .side-nav__item--personal-work.is-faded {
    color: rgba(53, 50, 105, 0.4);
  }

  .commissions-dropdown,
  .personal-work-dropdown,
  .all-work-dropdown {
    list-style: none;
    padding: 0;
    margin: 0;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
  }

  .commissions-dropdown.is-open,
  .personal-work-dropdown.is-open,
  .all-work-dropdown.is-open {
    max-height: 300px;
  }

  .commissions-dropdown__item,
  .personal-work-dropdown__item,
  .all-work-dropdown__item {
    display: block;
    width: 100%;
    font-family: 'Roboto Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(53, 50, 105, 0.4);
    padding: 0.35rem 0 0.35rem 0.75rem;
    text-align: left;
    transition: color 0.2s ease;
  }

  .commissions-dropdown__item:hover,
  .personal-work-dropdown__item:hover,
  .all-work-dropdown__item:hover,
  .commissions-dropdown__item.is-active,
  .personal-work-dropdown__item.is-active,
  .all-work-dropdown__item.is-active {
    color: #e61515;
  }

  .side-nav__item--active {
    color: #e61515;
  }

  .side-nav__item.is-active {
    color: #e61515;
  }

  .rail-instagram {
    margin-top: auto;
    color: #e61515;
    line-height: 0;
    opacity: 0.75;
    transition: opacity 0.25s ease;
  }

  .rail-instagram:hover {
    opacity: 1;
  }

  /* ── Piece grid ───────────────────────────────────── */

  .piece-grid {
    position: fixed;
    left: 260px;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 6rem 1.75rem 6rem;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: start;
    gap: 2rem;
    background: #faf9f7;
    overflow-y: auto;
    scrollbar-gutter: stable;
  }

  .piece-card {
    position: relative;
    cursor: pointer;
    outline: none;
  }

  .piece-card__img-wrap {
    width: 100%;
  }

  .piece-card__img {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    user-select: none;
    transition: opacity 0.25s ease;
  }

  .piece-card:hover .piece-card__img {
    opacity: 0;
  }

  .piece-card__title {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: 'SimSun', serif;
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    color: #e61515;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    text-align: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .piece-card:hover .piece-card__title {
    opacity: 1;
  }

  /* ── Section intro (inline grid text block) ─────── */

  .section-intro {
    grid-column: 1 / -1;
    grid-row: 1;
    display: none;
    flex-direction: column;
    font-family: 'Roboto Mono', monospace;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.03em;
    color: #e61515;
    line-height: 1.7;
    padding-bottom: 0.5rem;
  }

  .section-intro.is-visible {
    display: flex;
  }

  .section-intro p {
    margin-bottom: 0.875rem;
  }

  .section-intro p:last-child {
    margin-bottom: 0;
  }

  /* ── About view ─────────────────────────────────── */

  .about-view {
    position: fixed;
    left: 260px;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 3rem 1.75rem 3rem;
    box-sizing: border-box;
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
    z-index: 201;
  }

  .about-view.is-visible {
    opacity: 1;
    pointer-events: all;
  }

  .about-view__inner {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .about-view__text {
    display: flex;
    flex-direction: column;
    height: calc(0.375 * (100vw - 260px - 8rem));
  }

  .about-view__photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 78%;
    display: block;
  }

  .about-view__inner p,
  .about-view__inner address {
    font-family: 'Roboto Mono', monospace;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.03em;
    color: #e61515;
    line-height: 1.7;
    margin-bottom: 0.875rem;
    font-style: normal;
  }

  .about-view__inner p:last-child {
    margin-bottom: 0;
  }

  .about-view__inner address {
    margin-top: auto;
    margin-bottom: 0;
  }

  .about-view__inner address > a {
    display: block;
    line-height: 1.7;
  }

  .about-view__inner address p {
    margin-bottom: 0.2rem;
    line-height: 1.4;
  }

  .about-view__inner address p:last-child {
    margin-top: 1.4em;
  }

  .about-view__inner address a + p {
    margin-top: 1em;
  }

  .about-view__inner a {
    color: inherit;
  }


  /* ── Main overlay ────────────────────────────────── */

  .main-overlay {
    position: fixed;
    inset: 0;
    background: rgba(252, 251, 249, 0.35);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    z-index: 300;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .main-overlay.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .main-overlay__content {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 80ch;
    z-index: 303;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
    text-align: center;
  }

  .main-overlay__content.show-content {
    opacity: 1;
    pointer-events: all;
  }

  .main-overlay__content a {
    color: #e61515;
    border-bottom: 1px solid rgba(230, 21, 21, 0.3);
    transition: border-color 0.15s;
  }

  .main-overlay__content a:hover {
    border-bottom-color: #e61515;
  }

  /* ── Shared close button ─────────────────────────── */

  .close-btn {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 1;
    color: #e61515;
    padding: 0.35rem;
    line-height: 0;
    transition: opacity 0.15s;
  }

  .close-btn:hover {
    opacity: 0.5;
  }

  .close-btn--mobile-fixed {
    display: none;
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 250;
    color: #e61515;
    padding: 0.35rem;
    line-height: 0;
    transition: opacity 0.15s;
  }

  /* ── Info panel ──────────────────────────────────── */

  .info-panel {
    position: fixed;
    top: 0;
    left: 260px;
    width: 40%;
    height: 100vh;
    background: #faf9f7;
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease,
                width 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    overflow: hidden;
  }

  .info-panel.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .info-panel.is-wide {
    width: calc(100vw - 260px);
  }

  .info-panel__inner {
    display: flex;
    flex-direction: row;
    height: 100%;
    padding-left: 3rem;
  }

  .info-panel__details {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .info-panel.is-wide .info-panel__details {
    opacity: 1;
    pointer-events: all;
    transition: opacity 0.6s ease 0.6s;
  }

  .info-panel__scroll {
    flex: 1;
    overflow-y: auto;
    padding: 2rem 5rem 3.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    scrollbar-width: thin;
    scrollbar-color: #ddd transparent;
  }

  .info-panel__header {
    padding-top: 0;
  }

  .info-panel__name {
    font-family: 'SimSun', serif;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.1;
    color: #e61515;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .info-panel__year {
    margin-top: 0.6rem;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #aaa;
  }

  .info-panel__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 1.75rem;
    align-items: baseline;
    width: 100%;
  }

  .info-panel__meta dt {
    font-family: 'Roboto Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #bbb;
  }

  .info-panel__meta dd {
    font-family: 'Roboto Mono', monospace;
    font-size: 11px;
    color: #444;
    line-height: 1.55;
  }

  .info-panel__description {
    font-family: 'Roboto Mono', monospace;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.03em;
    color: #444;
    line-height: 1.7;
    white-space: pre-line;
    width: 100%;
  }

  .info-panel__description:empty {
    display: none;
  }

  .info-panel__description a {
    color: #e61515;
    text-decoration: none;
  }

  .info-panel__description a:hover {
    text-decoration: underline;
  }

  .info-panel__expand {
    position: fixed;
    left: 70vw;
    top: 50%;
    transform: translateX(-50%) translateY(-50%);
    font-family: 'SimSun', serif;
    font-size: 2.25rem;
    font-weight: 400;
    letter-spacing: 0.6em;
    text-transform: uppercase;
    color: #e61515;
    padding: 1rem 0.5rem;
    writing-mode: vertical-lr;
    text-orientation: upright;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 201;
  }

  .info-panel__expand.is-visible {
    opacity: 1;
    pointer-events: all;
  }

  .info-panel__expand:hover {
    opacity: 0.5;
  }

  .info-panel__gallery {
    flex: 0 0 calc((100vw - 260px - 8rem) / 2);
    position: relative;
  }

  .info-panel__gallery-scroll {
    position: absolute;
    inset: 0;
    overflow-y: scroll;
    scrollbar-width: none;
    padding-top: 2rem;
    padding-left: 3rem;
  }

  .info-panel__gallery-scroll::-webkit-scrollbar {
    display: none;
  }

  /* ── Nav arrows ─────────────────────────────────── */

  .piece-scrubber {
    position: fixed;
    bottom: 2.5rem;
    left: 50%;
    z-index: 205;
    transform: translateX(-50%);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.5rem;
    color: #e61515;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease,
                left 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .piece-scrubber.is-visible {
    opacity: 1;
    pointer-events: all;
  }

  .piece-scrubber__arrow {
    display: none;
  }

  /* ── Image scrubber ──────────────────────────────── */

  .gallery-progress {
    position: absolute;
    right: -2rem;
    top: 2rem;
