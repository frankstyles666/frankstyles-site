<script define:vars={{ pieces: browserPieces }}>
  const pieceGrid         = document.getElementById('piece-grid');
  const pieceCards        = Array.from(pieceGrid.querySelectorAll('.piece-card'));
  const aboutNavBtn       = document.getElementById('about-nav-btn');
  const siteTitle         = document.querySelector('.site-title');


  const infoPanel         = document.getElementById('info-panel');
  const infoBackdrop      = document.getElementById('info-backdrop');
  const infoClose         = document.getElementById('info-close');
  const mobileCloseBtn    = document.getElementById('info-close-mobile');
  const infoName          = document.getElementById('info-name');
  const infoYear          = document.getElementById('info-year');
  const infoMaterials     = document.getElementById('info-materials');
  const infoDimensions    = document.getElementById('info-dimensions');
  const infoDescription   = document.getElementById('info-description');
  const infoExpand        = document.getElementById('info-expand');
  const infoScroll        = document.getElementById('info-scroll');
  const infoGalleryScroll = document.getElementById('info-gallery-scroll');
  const arrowLeft         = document.getElementById('arrow-left');
  const arrowRight        = document.getElementById('arrow-right');
  const pieceScrubber     = document.getElementById('piece-scrubber');
  const galleryProgress   = document.getElementById('gallery-progress');

  const titleRawText = siteTitle.textContent;
  const isMobile = window.matchMedia('(max-width: 768px)').matches;

  let currentPieceId = null;
  let panelHistoryPushed = false;
  let closingViaHistory  = false;

  const _initSlug = window.location.pathname.replace(/^\/|\/$/g, '');
  const _initIdx  = _initSlug
    ? pieces.findIndex(p => p.id.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') === _initSlug)
    : -1;
  let currentIndex = _initIdx >= 0 ? _initIdx : 0;

  // ── Card click handlers ─────────────────────────────
  pieceCards.forEach((card, i) => {
    card.addEventListener('click', () => {
      currentIndex = i;
      openInfoPanel(pieces[i].id);
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        currentIndex = i;
        openInfoPanel(pieces[i].id);
      }
    });
  });

  // ── Category filter ────────────────────────────────
  const filterBtns = Array.from(document.querySelectorAll('[data-filter]'));

  const FILTER_DUR = 220;
  const GLIDE_DUR  = 480;
  const PHASE_DUR  = Math.round(GLIDE_DUR / 2);

  function applyFilter(filter, instant = false) {
    filterBtns.forEach(btn => {
      btn.classList.toggle('side-nav__item--active', btn.dataset.filter === filter);
    });

    const willBeVisible = c => filter === 'all' || c.dataset.category === filter;

    if (instant) {
      collabText.classList.toggle('is-visible', filter === 'for-client');
      personalWorkText.classList.toggle('is-visible', filter === 'for-me');
      pieceCards.forEach(c => {
        c.style.cssText = '';
        c.style.display = willBeVisible(c) ? '' : 'none';
      });
      return;
    }

    // Abort any in-flight animations cleanly
    pieceCards.forEach(c => {
      c.style.transition = 'none';
      c.style.transform  = '';
      if (c.style.display !== 'none') { c.style.opacity = '1'; }
      c.style.pointerEvents = '';
    });
    pieceGrid.offsetHeight;

    const leaving  = pieceCards.filter(c => c.style.display !== 'none' && !willBeVisible(c));
    const staying  = pieceCards.filter(c => c.style.display !== 'none' &&  willBeVisible(c));
    const entering = pieceCards.filter(c => c.style.display === 'none'  &&  willBeVisible(c));

    // Snapshot FIRST positions of staying cards before any DOM change
    const firstPos = new Map();
    staying.forEach(c => firstPos.set(c, c.getBoundingClientRect()));

    // Phase 1: fade out leaving cards
    leaving.forEach(c => {
      c.style.transition    = `opacity ${FILTER_DUR}ms ease`;
      c.style.opacity       = '0';
      c.style.pointerEvents = 'none';
    });

    setTimeout(() => {
      // Remove leaving cards from flow
      leaving.forEach(c => { c.style.display = 'none'; c.style.transition = ''; c.style.opacity = ''; });

      // Toggle section intro text blocks after leaving cards are gone so the grid settles before LAST snapshot
      collabText.classList.toggle('is-visible', filter === 'for-client');
      personalWorkText.classList.toggle('is-visible', filter === 'for-me');

      // Reveal entering cards invisibly so layout reflows
      entering.forEach(c => { c.style.display = ''; c.style.opacity = '0'; c.style.transition = 'none'; });

      // Snapshot LAST positions of staying cards after reflow
      const lastPos = new Map();
      staying.forEach(c => lastPos.set(c, c.getBoundingClientRect()));

      // INVERT: push staying cards back to their FIRST positions via transform
      const deltas = new Map();
      staying.forEach(c => {
        const f = firstPos.get(c), l = lastPos.get(c);
        if (!f || !l) return;
        const dx = f.left - l.left, dy = f.top - l.top;
        deltas.set(c, { dx, dy });
        c.style.transition = 'none';
        c.style.transform  = `translate(${dx}px, ${dy}px)`;
      });

      // Force reflow to commit the inverted state
      pieceGrid.offsetHeight;

      // Cards moving on both axes animate in two steps to avoid diagonal paths.
      // Phase order depends on vertical direction so the reverse trip mirrors the forward:
      //   Moving UP   (dy > 0): vertical first → UP then horizontal
      //   Moving DOWN (dy < 0): horizontal first → horizontal then DOWN
      // Both paths use the same L-shaped corner, traversed in opposite order.
      const twoPhase = staying.filter(c => {
        const d = deltas.get(c);
        return d && Math.abs(d.dx) > 0.5 && Math.abs(d.dy) > 0.5;
      });
      const onePhase = staying.filter(c => {
        const d = deltas.get(c);
        return !d || !(Math.abs(d.dx) > 0.5 && Math.abs(d.dy) > 0.5);
      });

      // One-phase: animate straight to LAST position
      onePhase.forEach(c => {
        c.style.transition = `transform ${GLIDE_DUR}ms cubic-bezier(0.25, 0.46, 0.45, 0.94)`;
        c.style.transform  = '';
      });

      // Two-phase step 1
      // Both trips route through the empty corner cell (col2/row2), avoiding collab-text
      // at col1/row1 and the positions where entering cards will appear (col1/row1, col2/row1).
      //   Going UP   (dy > 0): horizontal first → RIGHT to col2/row2, then UP to col2/row1
      //   Going DOWN (dy < 0): vertical first   → DOWN to col2/row2, then LEFT to col1/row2
      twoPhase.forEach(c => {
        const { dx, dy } = deltas.get(c);
        const goingDown = dy < 0;
        c.style.transition = `transform ${PHASE_DUR}ms cubic-bezier(0.25, 0.46, 0.45, 0.94)`;
        // UP: remove dx (translate(0, dy) → col2/row2) · DOWN: remove dy (translate(dx, 0) → col2/row2)
        c.style.transform = goingDown ? `translate(${dx}px, 0)` : `translate(0, ${dy}px)`;
      });

      // Two-phase step 2: remove remaining offset
      if (twoPhase.length) {
        setTimeout(() => {
          twoPhase.forEach(c => {
            c.style.transition = `transform ${PHASE_DUR}ms cubic-bezier(0.25, 0.46, 0.45, 0.94)`;
            c.style.transform  = '';
          });
        }, PHASE_DUR);
      }

      // Both path variants reach the safe empty corner (col2/row2) after phase 1,
      // so entering cards can start fading in once phase 1 clears.
      const enterDelay = twoPhase.length > 0 ? PHASE_DUR : 0;
      setTimeout(() => {
        entering.forEach(c => {
          c.offsetHeight;
          c.style.transition    = `opacity ${FILTER_DUR}ms ease`;
          c.style.opacity       = '1';
          c.style.pointerEvents = '';
        });
      }, enterDelay);

      // Clean up after all animations finish
      const enterFinish = enterDelay + (entering.length ? FILTER_DUR : 0);
      setTimeout(() => {
        [...staying, ...entering].forEach(c => {
          c.style.transition    = '';
          c.style.transform     = '';
          c.style.opacity       = '';
          c.style.pointerEvents = '';
        });
      }, Math.max(GLIDE_DUR, enterFinish));

    }, leaving.length ? FILTER_DUR : 0);
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      lastFilter = f;
      closeOpenViews();
      applyFilter(f);
    });
  });

  pieceCards.forEach(c => { c.style.display = 'none'; });

  // ── Shallow routing ───────────────────────────────
  function getSlug(piece) {
    return piece.id.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  }

  function updateURL() {
    if (!infoPanel.classList.contains('is-open')) {
      history.replaceState(null, '', '/');
      return;
    }
    const slug = getSlug(pieces[currentIndex]);
    history.replaceState(null, '', '/' + slug);
  }

  // Auto-open panel if URL contains a valid slug on load
  if (_initIdx >= 0) {
    setTimeout(() => openInfoPanel(pieces[_initIdx].id), 0);
  }

  // ── Piece scrubber ─────────────────────────────────
  function updateArrows(instant) {
    const N      = pieces.length;
    const active = false;

    pieceScrubber.classList.toggle('is-visible', active);
    pieceScrubber.setAttribute('aria-hidden', active ? 'false' : 'true');
    if (!active) return;

    const idx    = currentIndex;
    const inset  = window.innerWidth * 0.18;
    const usable = window.innerWidth - inset * 2;
    const x      = inset + (idx / (N - 1)) * usable;

    if (instant) {
      pieceScrubber.style.transition = 'none';
      pieceScrubber.style.left = `${x}px`;
      pieceScrubber.offsetHeight;
      pieceScrubber.style.transition = '';
    } else {
      pieceScrubber.style.left = `${x}px`;
    }

    arrowLeft.classList.toggle('is-hidden',  isMobile && currentIndex === 0);
    arrowRight.classList.toggle('is-hidden', isMobile && currentIndex === N - 1);
  }

  arrowLeft.addEventListener('click',  (e) => { e.stopPropagation(); });
  arrowRight.addEventListener('click', (e) => { e.stopPropagation(); });

  // ── About view ─────────────────────────────────────
  const aboutView             = document.getElementById('about-view');
  const collabText            = document.getElementById('collab-text');
  const personalWorkText      = document.getElementById('personal-work-text');
  const commissionsDropdown   = document.getElementById('commissions-dropdown');
  const commissionsNavBtn     = document.getElementById('commissions-nav-btn');
  const personalWorkDropdown  = document.getElementById('personal-work-dropdown');
  const personalWorkNavBtn    = document.getElementById('personal-work-nav-btn');
  const allWorkDropdown       = document.getElementById('all-work-dropdown');
  const allWorkNavBtn         = document.getElementById('all-work-nav-btn');
  let aboutActive       = false;
  let commissionsActive = false;
  let personalWorkActive = false;
  let allWorkActive      = false;
  let lastFilter        = 'all';

  updateArrows(true);

  function openAbout() {
    if (infoPanel.classList.contains('is-open')) closeInfoPanel();
    closeOpenViews();
    aboutActive = true;
    aboutNavBtn.classList.add('side-nav__item--active');

    const visible = pieceCards.filter(c => c.style.display !== 'none');
    visible.forEach(c => {
      c.style.transition    = `opacity ${FILTER_DUR}ms ease`;
      c.style.opacity       = '0';
      c.style.pointerEvents = 'none';
    });

    const collabWasVisible = collabText.classList.contains('is-visible');
    const personalWorkTextWasVisible = personalWorkText.classList.contains('is-visible');
    if (collabWasVisible) {
      collabText.style.transition = `opacity ${FILTER_DUR}ms ease`;
      collabText.style.opacity    = '0';
    }
    if (personalWorkTextWasVisible) {
      personalWorkText.style.transition = `opacity ${FILTER_DUR}ms ease`;
      personalWorkText.style.opacity    = '0';
    }

    setTimeout(() => {
      visible.forEach(c => { c.style.display = 'none'; c.style.transition = ''; c.style.opacity = ''; });
      if (collabWasVisible) {
        collabText.classList.remove('is-visible');
        collabText.style.transition = '';
        collabText.style.opacity    = '';
      }
      if (personalWorkTextWasVisible) {
        personalWorkText.classList.remove('is-visible');
        personalWorkText.style.transition = '';
        personalWorkText.style.opacity    = '';
      }
      aboutView.removeAttribute('aria-hidden');
      aboutView.classList.add('is-visible');
      activateInfoBtn();
      updateTitle();
    }, FILTER_DUR);
  }

  function dismissAbout(nextFilter) {
    aboutActive = false;
    aboutNavBtn.classList.remove('side-nav__item--active');
    aboutView.classList.remove('is-visible');
    aboutView.setAttribute('aria-hidden', 'true');
    deactivateInfoBtn();
    updateTitle();

    setTimeout(() => {
      applyFilter(nextFilter ?? lastFilter);
    }, FILTER_DUR);
  }

  aboutNavBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    if (aboutActive) dismissAbout(); else openAbout();
  });

  function activateInfoBtn() {}
  function deactivateInfoBtn() {}

  // ── Shared: close any open nav view ───────────────────

  function closeOpenViews() {
    if (aboutActive) {
      aboutActive = false;
      aboutNavBtn.classList.remove('side-nav__item--active');
      aboutView.classList.remove('is-visible');
      aboutView.setAttribute('aria-hidden', 'true');
      deactivateInfoBtn();
    }
    if (commissionsActive) {
      commissionsActive = false;
      commissionsNavBtn.classList.remove('side-nav__item--active');
      commissionsDropdown.classList.remove('is-open');
    }
    if (personalWorkActive) {
      personalWorkActive = false;
      personalWorkNavBtn.classList.remove('side-nav__item--active');
      personalWorkDropdown.classList.remove('is-open');
    }
    if (allWorkActive) {
      allWorkActive = false;
      allWorkNavBtn.classList.remove('side-nav__item--active');
      allWorkDropdown.classList.remove('is-open');
    }
    commissionsNavBtn.classList.remove('is-faded');
    personalWorkNavBtn.classList.remove('is-faded');
  }

  // ── Commissions ────────────────────────────────────

  function openCommissions() {
    if (infoPanel.classList.contains('is-open')) closeInfoPanel();
    closeOpenViews();
    commissionsActive = true;
    commissionsNavBtn.classList.add('side-nav__item--active');
    commissionsDropdown.classList.add('is-open');
    personalWorkNavBtn.classList.add('is-faded');
    applyFilter('for-client');
    updateTitle();
  }

  function dismissCommissions() {
    commissionsActive = false;
    commissionsNavBtn.classList.remove('side-nav__item--active');
    commissionsDropdown.classList.remove('is-open');
    commissionsNavBtn.classList.remove('is-faded');
    personalWorkNavBtn.classList.remove('is-faded');
    applyFilter('all');
    updateTitle();
  }

  commissionsNavBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    if (commissionsActive) dismissCommissions(); else openCommissions();
  });

  commissionsDropdown.querySelectorAll('.commissions-dropdown__item').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      commissionsDropdown.querySelectorAll('.commissions-dropdown__item')
        .forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      openInfoPanel(btn.dataset.pieceId);
    });
  });

  // ── Personal Work ──────────────────────────────────

  function openPersonalWork() {
    if (infoPanel.classList.contains('is-open')) closeInfoPanel();
    closeOpenViews();
    personalWorkActive = true;
    personalWorkNavBtn.classList.add('side-nav__item--active');
    personalWorkDropdown.classList.add('is-open');
    commissionsNavBtn.classList.add('is-faded');
    applyFilter('for-me');
    updateTitle();
  }

  function dismissPersonalWork() {
    personalWorkActive = false;
    personalWorkNavBtn.classList.remove('side-nav__item--active');
    personalWorkDropdown.classList.remove('is-open');
    commissionsNavBtn.classList.remove('is-faded');
    personalWorkNavBtn.classList.remove('is-faded');
    applyFilter('all');
    updateTitle();
  }

  personalWorkNavBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    if (personalWorkActive) dismissPersonalWork(); else openPersonalWork();
  });

  personalWorkDropdown.querySelectorAll('.personal-work-dropdown__item').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      personalWorkDropdown.querySelectorAll('.personal-work-dropdown__item')
        .forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      openInfoPanel(btn.dataset.pieceId);
    });
  });

  // ── All Work view ─────────────────────────────────

  function openAllWork() {
    if (infoPanel.classList.contains('is-open')) closeInfoPanel();
    closeOpenViews();
    allWorkActive = true;
    allWorkNavBtn.classList.add('side-nav__item--active');
    allWorkDropdown.classList.add('is-open');
    applyFilter('all');
    updateTitle();
  }

  function dismissAllWork() {
    allWorkActive = false;
    allWorkNavBtn.classList.remove('side-nav__item--active');
    allWorkDropdown.classList.remove('is-open');
    applyFilter('all');
    updateTitle();
  }

  allWorkNavBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    if (allWorkActive) dismissAllWork(); else openAllWork();
  });

  allWorkDropdown.querySelectorAll('.all-work-dropdown__item').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      allWorkDropdown.querySelectorAll('.all-work-dropdown__item')
        .forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      openInfoPanel(btn.dataset.pieceId);
    });
  });

  // ── Info panel ─────────────────────────────────────

  function setPieceDetails(piece) {
    infoName.textContent        = piece.name;
    infoYear.textContent        = piece.year;
    infoMaterials.textContent   = piece.materials;
    infoDimensions.textContent  = piece.dimensions;
    infoDescription.innerHTML = piece.description || '';
  }

  function buildGallery(piece) {
    infoGalleryScroll.innerHTML = '';
    infoGalleryScroll.scrollTop = 0;
    let imgs = piece.additionalImages || [];
    if (!isMobile && piece.desktopFirstImage) {
      imgs = [piece.desktopFirstImage, ...imgs.slice(1)];
    }
    if (!imgs.length) return;
    imgs.forEach((imgData, idx) => {
      const item = document.createElement('div');
      item.className = 'info-img-item';
      const img = document.createElement('img');
      img.src = imgData.src ?? imgData;
      img.alt = piece.name;
      item.appendChild(img);
      infoGalleryScroll.appendChild(item);
    });
    infoGalleryScroll.scrollTop = 0;
  }

  function placeMainGallery(idx) {
    currentIndex = idx;
    updateURL();
  }

  let isSwitching = false;
  const SWITCH_DUR = 220;

  function switchPiece(direction) {
    if (!infoPanel.classList.contains('is-open')) return;
    if (isSwitching) return;
    const N = pieces.length;
    if (N < 2) return;

    const curIdx  = pieces.findIndex(p => p.id === currentPieceId);
    const nextIdx = (curIdx + direction + N) % N;

    const piece = pieces[nextIdx];
    isSwitching = true;
    currentPieceId = piece.id;
    updateArrows();

    placeMainGallery(nextIdx);

    infoScroll.style.transition = `opacity ${SWITCH_DUR}ms ease, transform ${SWITCH_DUR}ms ease`;
    infoScroll.style.opacity   = '0';
    infoScroll.style.transform = `translateX(${-direction * 80}px)`;

    if (infoGalleryScroll.children.length) {
      infoGalleryScroll.style.transition = `opacity ${SWITCH_DUR}ms ease`;
      infoGalleryScroll.style.opacity   = '0';
    }

    setTimeout(() => {
      setPieceDetails(piece);

      if (piece.additionalImages && piece.additionalImages.length) {
        if (!infoPanel.classList.contains('is-wide')) {
          infoPanel.style.transition = 'none';
          infoPanel.classList.add('is-wide');
          infoPanel.offsetHeight;
          infoPanel.style.transition = '';
        }
        buildGallery(piece);
      } else {
        infoGalleryScroll.innerHTML = '';
        infoPanel.classList.remove('is-wide');
      }
      infoExpand.classList.remove('is-visible');

      infoScroll.style.transition = 'none';
      infoScroll.style.transform  = `translateX(${direction * 80}px)`;
      infoScroll.offsetHeight;
      infoScroll.style.transition = `opacity ${SWITCH_DUR}ms ease, transform ${SWITCH_DUR}ms ease`;
      infoScroll.style.opacity    = '1';
      infoScroll.style.transform  = 'translateX(0)';

      infoGalleryScroll.style.transition = `opacity ${SWITCH_DUR}ms ease`;
      infoGalleryScroll.style.opacity    = '1';

      setTimeout(() => {
        infoScroll.style.transition = '';
        infoScroll.style.opacity    = '';
        infoScroll.style.transform  = '';
        infoGalleryScroll.style.transition = '';
        infoGalleryScroll.style.opacity    = '';
        isSwitching = false;
      }, SWITCH_DUR);

      if (isMobile) infoPanel.scrollTop = 0;
      requestAnimationFrame(() => { infoGalleryScroll.scrollTop = 0; updateGalleryProgress(); });
      updateGalleryProgress();
    }, SWITCH_DUR);
  }

  let wheelSwitchLocked = false;
  function onOverlayWheel(e) {
    if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
    e.preventDefault();
    if (wheelSwitchLocked) return;
    const dir = e.deltaX > 5 ? 1 : e.deltaX < -5 ? -1 : 0;
    if (!dir) return;
    wheelSwitchLocked = true;
    setTimeout(() => { wheelSwitchLocked = false; }, 700);
    switchPiece(dir);
  }

  function flipArrows(beforeFn) {
    if (!isMobile) { beforeFn(); return; }
    const leftFirst  = arrowLeft.getBoundingClientRect();
    const rightFirst = arrowRight.getBoundingClientRect();
    beforeFn();
    const leftLast  = arrowLeft.getBoundingClientRect();
    const rightLast = arrowRight.getBoundingClientRect();
    const DUR = 500, EASE = 'cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    [
      [arrowLeft,  leftFirst.left  - leftLast.left,  leftFirst.top  - leftLast.top],
      [arrowRight, rightFirst.left - rightLast.left, rightFirst.top - rightLast.top],
    ].forEach(([el, dx, dy]) => {
      if (dx === 0 && dy === 0) return;
      el.style.transition = 'none';
      el.style.transform  = `translate(${dx}px,${dy}px)`;
    });
    arrowLeft.offsetHeight;
    [arrowLeft, arrowRight].forEach(el => {
      el.style.transition = `transform ${DUR}ms ${EASE}`;
      el.style.transform  = '';
    });
    setTimeout(() => {
      [arrowLeft, arrowRight].forEach(el => { el.style.transition = ''; el.style.transform = ''; });
    }, DUR);
  }

  function openInfoPanel(id) {
    const piece = pieces.find(p => p.id === id);
    if (!piece) return;
    currentPieceId = id;

    if (aboutActive) {
      aboutActive = false;
      aboutNavBtn.classList.remove('side-nav__item--active');
      aboutView.classList.remove('is-visible');
      aboutView.setAttribute('aria-hidden', 'true');
      deactivateInfoBtn();
    }

    setPieceDetails(piece);

    if (piece.additionalImages && piece.additionalImages.length) {
      infoGalleryScroll.innerHTML = '';
      infoPanel.style.transition = 'none';
      infoPanel.classList.add('is-wide');
      infoPanel.offsetHeight;
      infoPanel.style.transition = '';
      buildGallery(piece);
      requestAnimationFrame(() => { infoGalleryScroll.scrollTop = 0; updateGalleryProgress(); });
    } else {
      infoGalleryScroll.innerHTML = '';
    }

    flipArrows(() => infoPanel.classList.add('is-open'));
    infoExpand.classList.remove('is-visible');
    updateGalleryProgress();
    if (isMobile) {
      mobileCloseBtn.classList.add('is-visible');
      mobileCloseBtn.setAttribute('aria-hidden', 'false');
    }
    history.pushState({ infoPanelOpen: true }, '');
    panelHistoryPushed = true;

    infoPanel.setAttribute('aria-hidden', 'false');
    infoBackdrop.classList.add('is-active');
    updateTitle();
    updateArrows();
    updateURL();
  }

  function openExpanded() {
    const piece = pieces.find(p => p.id === currentPieceId);
    if (!piece || !piece.additionalImages || !piece.additionalImages.length) return;

    infoGalleryScroll.innerHTML = '';
    piece.additionalImages.forEach(imgData => {
      const item = document.createElement('div');
      item.className = 'info-img-item';
      const img = document.createElement('img');
      img.src = imgData.src ?? imgData;
      img.alt = piece.name;
      item.appendChild(img);
      infoGalleryScroll.appendChild(item);
    });

    infoPanel.classList.add('is-wide');
    infoExpand.classList.remove('is-visible');
    requestAnimationFrame(() => updateGalleryProgress());
  }

  function closeInfoPanel() {
    if (panelHistoryPushed && !closingViaHistory) {
      panelHistoryPushed = false;
      history.back();
    }
    flipArrows(() => infoPanel.classList.remove('is-open'));
    infoPanel.setAttribute('aria-hidden', 'true');
    if (isMobile) { mobileCloseBtn.classList.remove('is-visible'); mobileCloseBtn.setAttribute('aria-hidden', 'true'); }
    infoBackdrop.classList.remove('is-active');
    document.removeEventListener('wheel', onOverlayWheel);
    updateGalleryProgress();
    infoExpand.innerHTML = 'View more images';
    infoExpand.classList.remove('is-visible');
    setTimeout(() => {
      infoPanel.classList.remove('is-wide');
      infoGalleryScroll.innerHTML = '';
      infoGalleryScroll.scrollTop = 0;
    }, 460);
    currentPieceId = null;
    commissionsDropdown.querySelectorAll('.commissions-dropdown__item')
      .forEach(b => b.classList.remove('is-active'));
    updateTitle();
    updateArrows();
    updateURL();
  }

  infoExpand.addEventListener('click', openExpanded);
  infoClose.addEventListener('click', closeInfoPanel);
  mobileCloseBtn.addEventListener('click', closeInfoPanel);
  infoBackdrop.addEventListener('click', closeInfoPanel);


  window.addEventListener('popstate', () => {
    if (infoPanel.classList.contains('is-open')) {
      closingViaHistory = true;
      panelHistoryPushed = false;
      closeInfoPanel();
      closingViaHistory = false;
    }
  });

  function goHome() {
    if (infoPanel.classList.contains('is-open')) closeInfoPanel();
    closeOpenViews();
    applyFilter('all');
    updateTitle();
  }

  siteTitle.addEventListener('click', goHome);

  function updateTitle() {
    const panelOpen = infoPanel.classList.contains('is-open');
    siteTitle.classList.toggle('is-panel-open', panelOpen);
    siteTitle.classList.toggle('is-overlay-active', panelOpen || aboutActive || commissionsActive || personalWorkActive);
  }

  // ── Image scrubber ──────────────────────────────────

  function getGalleryItems() {
    return Array.from(infoGalleryScroll.querySelectorAll('.info-img-item'));
  }

  function currentImgIndex() {
    const items = getGalleryItems();
    if (!items.length) return 0;
    const viewCentre = infoGalleryScroll.scrollTop + infoGalleryScroll.clientHeight / 2;
    let best = 0, bestDist = Infinity;
    items.forEach((it, i) => {
      const d = Math.abs((it.offsetTop + it.offsetHeight / 2) - viewCentre);
      if (d < bestDist) { bestDist = d; best = i; }
    });
    return best;
  }

  function scrollToImg(idx) {
    const items = getGalleryItems();
    if (!items[idx]) return;
    const item = items[idx];
    const target = item.offsetTop + item.offsetHeight / 2 - infoGalleryScroll.clientHeight / 2;
    infoGalleryScroll.scrollTo({ top: Math.max(0, target), behavior: 'smooth' });
  }

  function updateGalleryProgress() {
    const active = infoPanel.classList.contains('is-open')
      && infoPanel.classList.contains('is-wide');

    galleryProgress.classList.toggle('is-visible', active);
    if (!active) return;

    const scrollEl  = infoGalleryScroll;
    const maxScroll = scrollEl.scrollHeight - scrollEl.clientHeight;
    const imgs      = Array.from(infoGalleryScroll.querySelectorAll('img'));
    const allLoaded = imgs.length > 0 && imgs.every(img => img.complete && img.naturalHeight > 0);
    const progress  = maxScroll > 0 ? scrollEl.scrollTop / maxScroll : (allLoaded ? 1 : 0);
    const paddingLeft = parseFloat(getComputedStyle(scrollEl).paddingLeft);
    const portraitH   = (scrollEl.clientWidth - paddingLeft) * 1.3;
    const minH        = Math.max(portraitH * 0.04, 6);
    galleryProgress.style.height = `${minH + (portraitH - minH) * progress}px`;
  }

  let progressTick = false;
  infoGalleryScroll.addEventListener('scroll', () => {
    if (progressTick) return;
    progressTick = true;
    requestAnimationFrame(() => { progressTick = false; updateGalleryProgress(); });
  });

  window.addEventListener('resize', () => { updateGalleryProgress(); updateArrows(true); });

  // ── Escape key ─────────────────────────────────────
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (infoPanel.classList.contains('is-open')) closeInfoPanel();
      else if (aboutActive || commissionsActive || personalWorkActive || allWorkActive) { closeOpenViews(); updateTitle(); }
      return;
    }
    if (infoPanel.classList.contains('is-open')) {
      if (infoPanel.classList.contains('is-wide')) {
        if (e.key === 'ArrowUp')   { e.preventDefault(); scrollToImg(currentImgIndex() - 1); }
        if (e.key === 'ArrowDown') { e.preventDefault(); scrollToImg(currentImgIndex() + 1); }
      }
    }
  });

</script>
